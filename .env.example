# PRD Genie — configuration for everything that runs OUTSIDE n8n.
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
#
# There are deliberately NO LLM API keys here. Every model call goes through n8n
# (WF0 for the doer, WF6 for the judge), so OpenAI and Gemini credentials live only
# in n8n's own credential store. The review service and the eval harness are
# deterministic by design and never call a provider — see docs/adr/0004.

# --- n8n ---------------------------------------------------------------------
# n8n is SHARED INFRASTRUCTURE and does not belong to this project. It runs from
# `infra/n8n/docker-compose.yml` as the container `n8n-local`, in its own compose
# project, on a volume owned by the machine rather than by any application.
#
#   docker volume create n8n_local_data                             (first time only)
#   docker compose -f infra/n8n/docker-compose.yml up -d
#
# PRD Genie is a guest: every workflow it creates is tagged `prdgenie`, the export
# filters on that tag, and nothing this project runs will ever destroy the instance
# or its volume. The repo is the source of truth for workflows — n8n is only the
# runtime, and `n8n/workflows/*.json` rebuilds our half in one command (ADR 0010).
#
# If you already run an n8n elsewhere, point the two URLs below at it instead; the
# rest of the project does not care which instance answers.
N8N_API_URL=http://localhost:5678
# Settings -> n8n API -> create an API key. Used only by `npm run export:n8n`.
N8N_API_KEY=
# The WF1 ingest door. The eval harness posts fixtures here.
N8N_INGEST_WEBHOOK_URL=http://localhost:5678/webhook/ingest
# Every workflow this project creates carries this tag. The export filters on it.
N8N_WORKFLOW_TAG=prdgenie

# --- Hosted n8n only (n8n Cloud, or a server you have no Docker shell into) --------------
# `deploy-hosted.mjs` deploys through the n8n API instead of the container CLI. It needs
# N8N_API_URL and N8N_API_KEY above, SERVICE_BASE_URL below AS N8N REACHES IT (a public
# URL or a tunnel, never localhost), and the ids of the two provider credentials you created
# in the n8n UI — copy each from the address bar, .../credentials/<id>. The keys themselves
# stay in n8n. See deliverables/SETUP.md.
OPENAI_CREDENTIAL_ID=
GEMINI_CREDENTIAL_ID=

# --- Review service ----------------------------------------------------------
SERVICE_PORT=3000
DB_PATH=./data/prdgenie.db
# n8n calls back into the service on this base URL (must be reachable from n8n;
# if n8n runs in Docker, use http://host.docker.internal:3000).
SERVICE_BASE_URL=http://localhost:3000
# Shared secret n8n sends on /internal/* calls so the deterministic endpoints
# are not open to anything else on localhost.
INTERNAL_API_KEY=change-me-any-random-string
